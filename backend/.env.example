# Server
PORT=5000
NODE_ENV=development

# MongoDB — use ONE of the following:
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/inferanews
# MongoDB Atlas (replace with your cluster URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inferanews?retryWrites=true&w=majority

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000
